# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_XXXX
STRIPE_WEBHOOK_SECRET=whsec_XXXX

# ── Supabase ──────────────────────────────────────────────────────────────────
# Hämta från: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://XXXX.supabase.co
SUPABASE_SERVICE_ROLE_KEY=******

# ── Resend (orderbekräftelsemail) ─────────────────────────────────────────────
# Skapa konto på resend.com, hämta API-nyckel och verifiera din avsändardomain
RESEND_API_KEY=re_XXXX
# Måste matcha en verifierad domain i Resend
RESEND_FROM_EMAIL=noreply@din-domain.se

# ── Site URL ──────────────────────────────────────────────────────────────────
# Produktions-URL (utan avslutande snedstreck)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Admin ─────────────────────────────────────────────────────────────────────
ADMIN_PASSWORD=byt-till-starkt-losenord

# ── Umami Analytics (valfritt, cookiefri, GDPR-kompatibel) ───────────────────
NEXT_PUBLIC_UMAMI_WEBSITE_ID=ditt-umami-webbplats-id

# ── Dev (Windows-optimering) ──────────────────────────────────────────────────
WATCHPACK_POLLING=false
