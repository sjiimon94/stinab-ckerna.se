# Stripe
STRIPE_SECRET_KEY=sk_test_XXXX
STRIPE_WEBHOOK_SECRET=whsec_XXXX

# Site URL (used for Stripe redirect URLs and metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin panel password
ADMIN_PASSWORD=byt-till-starkt-losenord

# Umami Analytics (optional – cookiefri, GDPR-kompatibel)
# Skapa konto på umami.is, lägg till webbplats och kopiera website ID:t hit.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=ditt-umami-webbplats-id

# Dev-miljö: inaktivera polling-baserad file watching (Windows-optimering)
WATCHPACK_POLLING=false
